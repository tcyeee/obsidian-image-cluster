{
	"name": "image-cluster",
	"version": "1.4.12",
	"description": "Group multiple images into a tidy gallery grid or photo collage inside your notes. Customize size, gap, border radius and shadow for a clean, organized markdown layout — ideal for note-taking and visual journals.",
	"main": "main.js",
	"scripts": {
		"dev": "node deploy/esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node deploy/esbuild.config.mjs production",
		"lint": "eslint . --ext .ts",
		"test": "vitest run",
		"version": "node deploy/version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": ["obsidian", "obsidian-plugin", "image-gallery", "collage", "image-grid", "note-taking", "markdown"],
	"author": "tcyeee",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.0.0",
		"@codemirror/view": "^6.0.0",
		"@types/node": "^20.19.43",
		"@typescript-eslint/eslint-plugin": "5.62.0",
		"@typescript-eslint/parser": "5.62.0",
		"esbuild": "0.25.0",
		"eslint": "^8.57.0",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4",
		"vitest": "^3.2.7"
	},
	"packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
